# .gitignore for ContractLens

# Python Virtual Environments & Packages
.venv/
env/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.vite/

# Intermediate / Generated Data (Processed chunks, embeddings cache, vector DBs)
Data/processed/
Data/cache/
Data/indices/
*.chroma/
*.faiss
*.sqlite
*.db

# Environment & Credentials
.env
.env.local
.env.*.local
*.pem
*.key

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Test & Coverage Outputs
.pytest_cache/
.coverage
htmlcov/
