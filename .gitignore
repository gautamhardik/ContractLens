# .gitignore for ContractLens

# Python Virtual Environments & Packages
.venv/
env/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.vite/
frontend/dist/

# Intermediate / Generated Data (Processed chunks, embeddings cache, vector DBs)
Data/processed/
Data/cache/
Data/indices/
Data/uploads/
*.chroma/
*.faiss
*.sqlite
*.db

# Environment & Credentials — NEVER commit these
.env
.env.local
.env.*.local
*.pem
*.key

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Test & Coverage Outputs
.pytest_cache/
.coverage
htmlcov/

# Generated / Scratch Artifacts
Data/corpus_cache.pkl
*.pkl
dom_*.png
shard_*.png
test_*.png
test_frontend_dom.py
DESIGN_RESEARCH.md
experiments/
