# ContractLens — Environment Variables Template
# Copy this file to .env and fill in your values. Never commit .env to git.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: "nvidia" | leave blank for deterministic fallback (no LLM)
LLM_PROVIDER=nvidia

# NVIDIA NIM API key — get one free at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Model to use for answer synthesis (default below is recommended)
NVIDIA_MODEL_NAME=meta/llama-3.2-11b-vision-instruct

# ── Corpus Preloading ─────────────────────────────────────────────────────────
# Set to "true" to preload Data/raw/ PDFs on startup (used in production)
PRELOAD_CORPUS=false
